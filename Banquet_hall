<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Banquet Hall Booking Chatbot</title>

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f4f4f4;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .chat-container {
        width: 400px;
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    .chat-header {
        background: #8B0000;
        color: white;
        padding: 15px;
        text-align: center;
        font-size: 20px;
    }

    .chat-box {
        height: 450px;
        overflow-y: auto;
        padding: 15px;
        display: flex;
        flex-direction: column;
    }

    .message {
        padding: 10px;
        margin: 5px 0;
        border-radius: 10px;
        max-width: 80%;
    }

    .bot {
        background: #f0f0f0;
        align-self: flex-start;
    }

    .user {
        background: #8B0000;
        color: white;
        align-self: flex-end;
    }

    .input-area {
        display: flex;
        border-top: 1px solid #ddd;
    }

    input {
        flex: 1;
        padding: 12px;
        border: none;
        outline: none;
    }

    button {
        background: #8B0000;
        color: white;
        border: none;
        padding: 12px 20px;
        cursor: pointer;
    }

    button:hover {
        background: #a50000;
    }
</style>
</head>
<body>

<div class="chat-container">
    <div class="chat-header">
        Banquet Hall Booking Assistant
    </div>

    <div class="chat-box" id="chatBox"></div>

    <div class="input-area">
        <input type="text" id="userInput" placeholder="Type your answer...">
        <button onclick="sendMessage()">Send</button>
    </div>
</div>

<script>
const questions = [
    "Welcome! What is your full name?",
    "Please enter your mobile number.",
    "What is your email address?",
    "What type of event are you planning?",
    "What is the event date? (DD/MM/YYYY)",
    "How many guests are expected?",
    "Do you require catering services? (Yes/No)",
    "Any special requirements?"
];

let currentQuestion = 0;
let bookingDetails = {};

const fields = [
    "Name",
    "Mobile",
    "Email",
    "Event Type",
    "Event Date",
    "Guests",
    "Catering",
    "Special Requirements"
];

const chatBox = document.getElementById("chatBox");

function addMessage(text, sender) {
    const msg = document.createElement("div");
    msg.classList.add("message", sender);
    msg.textContent = text;
    chatBox.appendChild(msg);
    chatBox.scrollTop = chatBox.scrollHeight;
}

function askQuestion() {
    if (currentQuestion < questions.length) {
        addMessage(questions[currentQuestion], "bot");
    } else {
        let summary = "Booking Details:\n\n";

        for (let key in bookingDetails) {
            summary += `${key}: ${bookingDetails[key]}\n`;
        }

        addMessage("Thank you! Your banquet hall booking request has been recorded.", "bot");

        setTimeout(() => {
            alert(summary);
        }, 500);
    }
}

function sendMessage() {
    const input = document.getElementById("userInput");
    const answer = input.value.trim();

    if (answer === "") return;

    addMessage(answer, "user");

    bookingDetails[fields[currentQuestion]] = answer;

    input.value = "";
    currentQuestion++;

    setTimeout(askQuestion, 500);
}

document.getElementById("userInput").addEventListener("keypress", function(e) {
    if (e.key === "Enter") {
        sendMessage();
    }
});

askQuestion();
</script>

</body>
</html>
